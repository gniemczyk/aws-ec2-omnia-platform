# =============================================================================
# Grafana - zmienne srodowiskowe (lokalny development)
# =============================================================================
# Skopiuj ten plik jako .env i uzupelnij wlasciwymi wartosciami.
# UWAGA: .env jest ignorowany przez git - nie commituj go!
# =============================================================================

# Port na ktorym nasluchuje Grafana (lokalnie)
APP_PORT=3000

# Login admina Grafany
GF_SECURITY_ADMIN_USER=admin

# Haslo admina Grafany (ZMIEN PRZED UZYCIEM!)
GF_SECURITY_ADMIN_PASSWORD=change-me

# Pluginy do zainstalowania (oddzielone srednikami)
GF_INSTALL_PLUGINS=grafana-clock-panel
