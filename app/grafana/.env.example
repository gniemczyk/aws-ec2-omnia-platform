# =============================================================================
# Grafana - zmienne srodowiskowe (lokalny development)
# =============================================================================
# Skopiuj ten plik jako .env i uzupelnij wlasciwymi wartosciami.
# UWAGA: .env jest ignorowany przez git - nie commituj go!
# =============================================================================

# Port na ktorym nasluchuje Grafana (lokalnie)
APP_PORT=3000

# Login admina Grafany
GF_SECURITY_ADMIN_USER=admin

# Haslo admina Grafany (ZMIEN PRZED UZYCIEM!)
GF_SECURITY_ADMIN_PASSWORD=change-me

# AWS - domyslny region dla CloudWatch datasource
# UWAGA: docker-compose.yml uzywa ${AWS_DEFAULT_REGION:-eu-central-1}, wiec
# jesli ta zmienna nie jest ustawiona, fallback to eu-central-1. Jesli jest
# ustawiona na pusty string, docker-compose NIE uzyje fallbacku, tylko pusty
# string, co spowoduje blad CloudWatch.
AWS_DEFAULT_REGION=eu-central-1

# AWS - uzycie dualstack (IPv4 + IPv6) endpointow
AWS_USE_DUALSTACK_ENDPOINT=true

# Poziom logowania Grafany (debug/info/warn/error)
# info = standardowe logi (produkcja)
# debug = tylko do diagnozowania CloudWatch
GF_LOG_LEVEL=info

# Pluginy do zainstalowania (oddzielone srednikami)
GF_INSTALL_PLUGINS=grafana-clock-panel
