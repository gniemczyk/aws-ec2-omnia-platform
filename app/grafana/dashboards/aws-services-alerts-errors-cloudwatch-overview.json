{
  "title": "AWS Services Alerts & Errors CloudWatch Overview",
  "uid": "aws-alerts-errors",
  "description": "CloudWatch monitoring for critical errors and alerts: ALB HTTP errors, RDS latency, Lambda throttles, DynamoDB errors, SQS message age",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "AWS CloudWatch",
      "url": "https://{{region}}.console.aws.amazon.com/cloudwatch/home?region={{region}}",
      "type": "link",
      "icon": "external link",
      "asDropdown": false,
      "targetBlank": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "ALB HTTP 5xx Errors (Sum)",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "LoadBalancer": "$elb"
          },
          "statistic": "Sum",
          "period": "auto",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "legendFormat": "${LoadBalancer} 5xx Errors"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "max",
            "mean",
            "last"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisPlacement": "auto",
            "axisLabel": "errors"
          }
        },
        "overrides": []
      }
    },
