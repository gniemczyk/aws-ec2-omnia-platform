# =============================================================================
# Zmienne środowiskowe dla Komiser
# =============================================================================
# Konto AWS dodaje sie recznie przez UI w zakladce Cloud Accounts.
# Nie potrzebujesz tu kluczy AWS - sluzy do tego interfejs www.

# Port, na ktorym nasluchuje aplikacja (domyslnie 3001, aby nie kolidowac z Grafana 3000)
APP_PORT=3001

# Region AWS domyslny (Komiser i tak zeskanuje wszystkie regiony)
AWS_DEFAULT_REGION=eu-central-1
